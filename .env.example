# SkillSwap Production Environment Configuration
# Copy this file to .env.local for local development or configure these variables in Vercel Project Settings.

# ==============================================================================
# 1. Supabase Credentials (Database, Auth, Realtime, RLS)
# ==============================================================================
# Public project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Public anonymous key (Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Secret service role key (REQUIRED for Escrow Ledger mutations, RLS bypass on backend)
# Never expose this key in the client! Keep safe on Vercel environment secrets.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# 2. Razorpay Payment Gateway (1 Token = ₹1 / 100 paise)
# ==============================================================================
# Public Key ID for Razorpay Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx

# Razorpay Key Secret (Used on server to verify HMAC signatures)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay Webhook Secret (Used to authenticate payment.captured webhooks)
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# 3. Application Deployment & URLs
# ==============================================================================
# Canonical public application URL
NEXT_PUBLIC_APP_URL=https://skillswap.ink

# ==============================================================================
# 4. Role-Based Access Control (RBAC) & Admin Permissions
# ==============================================================================
# Comma-separated list of additional administrator emails granted access to /admin
# Note: Primary admin elanghovansabareesh0921@gmail.com is granted access by default.
NEXT_PUBLIC_ADMIN_EMAILS=elanghovansabareesh0921@gmail.com,admin@skillswap.ink
